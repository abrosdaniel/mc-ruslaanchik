{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anthub.dev/schemas/v1/project.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 20
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "authors"
      ]
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "manifest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "version",
        "manifest"
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "news": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "changelog": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": []
    },
    "minecraft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "loader": {
          "const": "neoforge"
        },
        "loaderVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "version",
        "loader",
        "loaderVersion"
      ]
    },
    "anthub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      },
      "required": [
        "minVersion"
      ]
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "customFiles": {
          "enum": [
            "warn",
            "deny"
          ]
        }
      },
      "required": [
        "customFiles"
      ]
    },
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "id",
          "name",
          "address"
        ]
      },
      "maxItems": 100
    },
    "defaultServerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "luckperms": {
          "type": "boolean"
        }
      },
      "required": [
        "luckperms"
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "logo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "banner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": []
    }
  },
  "required": [
    "schemaVersion",
    "project",
    "pack",
    "minecraft",
    "anthub",
    "policies",
    "servers",
    "integrations",
    "theme",
    "content"
  ]
}
