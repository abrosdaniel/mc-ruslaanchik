{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/abrosdaniel/anthub/HEAD/schemas/v1/public-key.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "publicKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "schemaVersion",
    "keyId",
    "algorithm",
    "publicKey"
  ]
}
